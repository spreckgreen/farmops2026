# Caddy reverse proxy with automatic ACME (Let's Encrypt) TLS.
#
# ACME_DOMAIN and ACME_EMAIL come from .env (see docker-compose.yml). Caddy
# solves the HTTP-01 challenge on port 80, obtains a cert from Let's Encrypt,
# and renews it automatically ~30 days before expiry. Certs persist in the
# `caddy_data` named volume so restarts don't re-issue.
#
# Prereqs before `docker compose up -d`:
#   1. DNS: A/AAAA records for {$ACME_DOMAIN} AND {$SUPABASE_DOMAIN} pointing
#      at this host's public IP.
#   2. Firewall: ports 80 and 443 reachable from the public internet
#      (Let's Encrypt must hit :80 to validate).
#   3. .env: ACME_DOMAIN=farmops.bostead.life  ACME_EMAIL=you@example.com
#           SUPABASE_DOMAIN=supabase.farmops.bostead.life

{
	email {$ACME_EMAIL}
	# Uncomment to test against Let's Encrypt staging (no rate limits, untrusted certs):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# --- App -----------------------------------------------------------------
{$ACME_DOMAIN} {
	encode zstd gzip
	# JSON access log on disk so the in-app troubleshooting page can tail the
	# Caddy->app hop (./logs/caddy is mounted read-only into the app container).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
	reverse_proxy app:3000
}

# --- Self-hosted Supabase internal API gateway ---------------------------
# The active gateway is reached through the shared supabase_default Docker
# network. The `kong` alias resolves to Envoy v0.8 or optional Kong.
# Caddy provides public TLS; no Supabase gateway port is published on the host.
{$SUPABASE_DOMAIN} {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
	reverse_proxy kong:8000
}
