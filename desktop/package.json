{
  "name": "farmops-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "pack:dir": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "life.bostead.farmops",
    "productName": "FarmOps Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "executableName": "FarmOpsDesktop"
  },
  "description": "Offline-capable FarmOps desktop client for Windows and Linux",
  "author": "Bostead Farms",
  "repository": {
    "type": "git",
    "url": "https://github.com/spreckgreen/farmops2026.git",
    "directory": "desktop"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
