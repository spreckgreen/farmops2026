{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev:clean": "rimraf node_modules/.vite",
    "predev": "bun run dev:clean",
    "dev": "vite dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 BUILD_LOW_MEM=1 vite build",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=6144 BUILD_LOW_MEM=1 vite build --mode development",
    "build:progress": "node scripts/build-with-progress.mjs",
    "build:progress:quiet": "BUILD_QUIET=1 node scripts/build-with-progress.mjs",
    "build:ci": "BUILD_QUIET=1 BUILD_STALL_SECS=600 BUILD_MAX_SECS=2700 node scripts/build-with-progress.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:terminology": "bun scripts/terminology-check.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:auth:unit": "vitest run tests/auth.test.tsx tests/profile-gate.test.tsx tests/app-layout.test.tsx",
    "test:auth:e2e": "playwright test e2e/auth.spec.ts",
    "prepublish:auth": "bun run test:auth:unit && bun run test:auth:e2e",
    "test:watch": "vitest",
    "test:rls": "bun scripts/test-rls.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "vitest run && vite build",
    "prepublish:check": "vitest run && bun scripts/test-rls.ts && echo '✅ Run the Deep Security Scan in the Lovable Security tab before clicking Publish.'"
  },
