# Bostead — example environment variables
#
# Copy this file to `.env` in the project root before running Docker or the
# Node.js runtime:
#
#   cp .env.example .env
#
# Then replace the `your-*` placeholders with the values from your Supabase
# project. The file is read by `docker compose` automatically, and by the
# Node.js quickstart via `set -a && source .env && set +a`.

# --- Supabase (required) -----------------------------------------------------
# VITE_* values are inlined into the client bundle at build time, so they must
# be set BEFORE `docker compose up --build` or `bun run build`.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side equivalents (required at runtime by server functions / SSR).
# Use the same URL and the same publishable/anon key as above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service role key — REQUIRED for admin server code (user_roles checks,
# webhooks, maintenance tasks). Keep this secret; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider ------------------------------------------------------------
# The docker-compose stack ships with a bundled Ollama service that serves
# llama3.2:3b on an OpenAI-compatible /v1 endpoint. With no overrides here,
# the app auto-wires to it (CUSTOM_AI_BASE_URL=http://ollama:11434/v1,
# CUSTOM_AI_MODEL=llama3.2:3b) and runs fully offline with no API keys.
#
# Override any of the three lines below to point at a different provider:
#   OpenAI:      CUSTOM_AI_BASE_URL=https://api.openai.com/v1
#                CUSTOM_AI_API_KEY=sk-...
#                CUSTOM_AI_MODEL=gpt-4o-mini
#   OpenRouter:  CUSTOM_AI_BASE_URL=https://openrouter.ai/api/v1
#                CUSTOM_AI_API_KEY=sk-or-...
#   Different Ollama model: CUSTOM_AI_MODEL=qwen2.5:3b   (auto-pulled on boot)
#CUSTOM_AI_BASE_URL=
#CUSTOM_AI_API_KEY=
#CUSTOM_AI_MODEL=

# --- Self-host UX flags -----------------------------------------------------
# Externally reachable origin of this deployment (used to build the Rachio
# webhook callback URL shown on the irrigation settings page).
#PUBLIC_APP_URL=https://farm.example.com
# Hide Lovable-hosted-only UI (publish-status panel on /sync). Defaults to
# `true` in docker-compose so a self-hosted install looks self-hosted.
#SELF_HOST_MODE=true

# --- Automatic peer audit-batch pull (optional) ------------------------------
# Only needed when this instance pulls applied audit batches from a peer
# FarmOps instance. Pulled batches are always preview-only.
#   ELECTRICAL_PEER_SYNC_TOKEN       peer API token (farmops_sk_...)
#   ELECTRICAL_PEER_SYNC_CRON_SECRET active automatic-pull key, copied from
#                                    Electrical -> Audit batches
# Self-hosted hosts have no pg_cron, so drive the trigger from the host:
#   sudo ./scripts/install-peer-sync-timer.sh --interval 15
#ELECTRICAL_PEER_SYNC_TOKEN=
#ELECTRICAL_PEER_SYNC_CRON_SECRET=

# --- TLS / ACME (Caddy reverse proxy) ---------------------------------------
# The bundled `caddy` service auto-provisions a Let's Encrypt cert for
# ACME_DOMAIN via the HTTP-01 challenge. Requirements:
#   1. A public DNS A/AAAA record for ACME_DOMAIN -> this host
#   2. Ports 80 and 443 open to the public internet
#   3. ACME_EMAIL set to a real address (LE recovery / expiry notices)
# Certs persist in the `caddy_data` volume and auto-renew ~30 days pre-expiry.
ACME_DOMAIN=farmops.bostead.life
ACME_EMAIL=admin@bostead.life
# Set PUBLIC_APP_URL to the same origin so in-app URLs (Rachio webhooks etc.) match:
#PUBLIC_APP_URL=https://farmops.bostead.life


# --- Secrets Vault (required for /vault) -------------------------------------
# 32-byte key, hex-encoded (64 hex chars). Used to AES-256-GCM encrypt every
# row in public.vault_secrets at rest. Generate once with:
#   openssl rand -hex 32
# TREAT AS IRREPLACEABLE — losing this value permanently destroys every
# stored secret. Back it up out-of-band (password manager / hardware token),
# never alongside database dumps, and never commit it to git.
VAULT_ENCRYPTION_KEY=your-64-hex-char-key

# --- Vault-backed env (optional) --------------------------------------------
# App-level secrets (e.g. GHOST_API_URL, GHOST_ADMIN_API_KEY,
# RACHIO_WEBHOOK_SECRET) can be stored as Shared vault entries with an
# "env_key" set instead of in this file. The server reads them via
# getServerEnv() with a 60s cache; values defined here are used as a
# fallback when no matching vault row exists.
#
# Bootstrap secrets MUST stay in env (they are needed to reach/decrypt the
# vault itself): VAULT_ENCRYPTION_KEY, SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY.


# --- Node runtime ------------------------------------------------------------
NODE_ENV=production


# --- Container user (Docker only) -------------------------------------------
# Match your host user so files written to bind-mounted volumes
# (./data, ./uploads) are owned correctly on the host.
# Run `id -u` and `id -g` on the host to find your values.
PUID=1000
PGID=1000

# --- Server port -------------------------------------------------------------
# Port the app listens on inside the container / Node process.
# Change the host-side mapping in docker-compose.yml if you change this.
PORT=3000
