# Bostead — .env template for a SELF-HOSTED Supabase (Option C)
#
# Assumes you're running the official Supabase Docker stack from
# https://github.com/supabase/supabase/tree/master/docker on the same VPS
# (or a peer VPS reachable over the docker network / LAN).
#
# Copy to the project root as `.env`, then replace the CHANGE-ME values
# with the ones from your Supabase stack's own `.env` (POSTGRES_PASSWORD,
# JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY).
#
#   cp docs/env.self-hosted-supabase.example .env
#   $EDITOR .env
#
# ─────────────────────────────────────────────────────────────────────────────
# WHERE EACH VALUE COMES FROM (Supabase self-host stack)
# ─────────────────────────────────────────────────────────────────────────────
#   Supabase .env key      → Bostead .env key(s)
#   ─────────────────────    ────────────────────────────────────────────────
#   ANON_KEY               → SUPABASE_PUBLISHABLE_KEY, VITE_SUPABASE_PUBLISHABLE_KEY
#   SERVICE_ROLE_KEY       → SUPABASE_SERVICE_ROLE_KEY
#   API_EXTERNAL_URL       → SUPABASE_URL, VITE_SUPABASE_URL   (public HTTPS)
#   SITE_URL               → PUBLIC_APP_URL                    (Bostead origin)
#
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET. Regenerate
# BOTH together whenever you rotate JWT_SECRET (never edit one in isolation).
# Generator: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# ─────────────────────────────────────────────────────────────────────────────


# --- Supabase (required) -----------------------------------------------------
# Public HTTPS URL of your Supabase API gateway (what the browser hits).
# Must be reachable from every user's browser AND from this container.
# Example: your Caddy/nginx proxies supabase.example.com -> kong:8000
# (`kong` is the compatibility alias on the supabase_default docker network; it
# resolves to Envoy on self-hosted/v0.8.0+, or to Kong if you kept it.)
VITE_SUPABASE_URL=https://supabase.example.com
SUPABASE_URL=https://supabase.example.com
#
# Faster server-side alternative (FarmOps + Supabase on the same docker
# network): leave VITE_SUPABASE_URL as the public URL above (it's baked into the
# browser bundle), but override SUPABASE_URL to the internal hostname so server
# calls skip the public round-trip. No gateway port is published on the host, so
# the internal name is the only non-public path:
#SUPABASE_URL=http://kong:8000


# ANON_KEY from your Supabase `.env` — long JWT starting with `eyJ...`.
# Same value on both lines. Safe to ship in the client bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_ANON_KEY_JWT
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_ANON_KEY_JWT

# SERVICE_ROLE_KEY from your Supabase `.env` — long JWT starting with `eyJ...`.
# Bypasses RLS; keep server-only. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_SERVICE_ROLE_KEY_JWT

# Self-hosted Supabase has no "project ref". Pick any stable slug — it becomes
# the localStorage auth key (`sb-<slug>-auth-token`). Changing it later logs
# every user out. Keep it lowercase, no spaces.
VITE_SUPABASE_PROJECT_ID=farm-prod


# --- AI provider ------------------------------------------------------------
# Default: bundled Ollama service in docker-compose (fully offline). Leave the
# three CUSTOM_AI_* lines commented to use it. Uncomment to point elsewhere.
#CUSTOM_AI_BASE_URL=https://api.openai.com/v1
#CUSTOM_AI_API_KEY=sk-...
#CUSTOM_AI_MODEL=gpt-4o-mini


# --- Self-host UX flags -----------------------------------------------------
# Public origin of THIS Bostead deployment (used for Rachio callback URLs).
PUBLIC_APP_URL=https://farm.example.com
SELF_HOST_MODE=true


# --- TLS / ACME (Caddy reverse proxy) ---------------------------------------
# The bundled Caddy proxies ACME_DOMAIN -> app:3000 with auto Let's Encrypt.
# Requires public DNS + ports 80/443 open. Use a real email for LE notices.
ACME_DOMAIN=farm.example.com
ACME_EMAIL=admin@example.com


# --- Secrets Vault (required for /vault) ------------------------------------
# 32-byte key, hex-encoded. Generate once with:  openssl rand -hex 32
# IRREPLACEABLE — losing this destroys every stored vault secret.
VAULT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_openssl_rand_hex_32


# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Match host UID/GID (run `id -u` / `id -g`) so bind-mounted ./data & ./uploads
# are owned correctly.
PUID=1000
PGID=1000
